{
  "name": "dsh-boot-studio",
  "version": "1.2.9",
  "lewisEnchantRelease": {
    "version": "1.2.9",
    "notes": "1.增加了部分动画和视频。\n2.修复已知问题，提升系统稳定性。"
  },
  "description": "DSH LEWIS ENCHANTMENT · 附魔台｜开机动画：铺满当前窗口的完整开场、自定义视频与封面、启动检查更新和磨砂提示。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets/*.mp4",
    "assets/end-covers",
    "assets/author",
    "assets/deepsea-notices",
    "assets/lxj-notices",
    "assets/startup-screen/LICENSE",
    "assets/startup-screen/NOTICE.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "BSD-3-Clause",
  "author": "FerrariLewis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FerrariLewis/open.git"
  },
  "homepage": "https://github.com/FerrariLewis/open#readme",
  "bugs": {
    "url": "https://github.com/FerrariLewis/open/issues"
  },
  "keywords": [
    "dsh-openup-lewis",
    "dsh-open-beauty",
    "open-beauty",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-animation",
    "splash",
    "startup",
    "settings",
    "video"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}