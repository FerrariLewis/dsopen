{
  "name": "dsh-boot-studio",
  "version": "1.3.0",
  "lewisEnchantRelease": {
    "version": "1.3.0",
    "notes": "1.更新了跟随harness切换语言\n\n作者觉得，ai没有国界，插件没有国界！终于告一段落，之后的小版本更新估计就是一些新增的好看动画啊，图片啊。删除一些难看/侵权的动画，图片什么的\n\n现在，感谢你用我的插件"
  },
  "lewisEnchantReleaseEn": {
    "version": "1.3.0",
    "notes": "1. Added support for following Harness language changes\n\nAs the author, I believe AI has no borders, and neither do plugins! This round of work is finally wrapped up. Future minor updates will probably add some nice-looking animations and images, and remove those that look bad or infringe on others' rights.\n\nThank you for using my plugin!"
  },
  "description": "DSH LEWIS ENCHANTMENT · 附魔台｜开机动画：铺满当前窗口的完整开场、自定义视频与封面、启动检查更新和磨砂提示。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets/*.mp4",
    "assets/end-covers",
    "assets/author",
    "assets/deepsea-notices",
    "assets/lxj-notices",
    "assets/startup-screen/LICENSE",
    "assets/startup-screen/NOTICE.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "BSD-3-Clause",
  "author": "FerrariLewis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FerrariLewis/open.git"
  },
  "homepage": "https://github.com/FerrariLewis/open#readme",
  "bugs": {
    "url": "https://github.com/FerrariLewis/open/issues"
  },
  "keywords": [
    "dsh-openup-lewis",
    "dsh-open-beauty",
    "open-beauty",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-animation",
    "splash",
    "startup",
    "settings",
    "video"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    }
  }
}
